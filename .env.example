# The daemon and its admin page, in a container.
#
#   docker compose up -d
#
# Copy this file to .env, fill in the tokens, and keep .env out of git.
# Never commit a real token: .env is ignored by git and by the build
# context (see .dockerignore).

# The admin page's token, at least 16 characters (the daemon refuses a
# shorter one, or a placeholder such as change-me). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASH_ADMIN_TOKEN=

# The token the Presto device holds, at least 16 characters; generate one the
# same way. Required: with none, the daemon would print a temporary token that
# stays in Docker's log.
DASH_SHARED_TOKEN=

# The host address the device port is published on. Leave it as it is to
# publish on every address, or set your LAN address (for example 192.168.1.50)
# so a host with a public interface does not expose it.
# DASH_PUBLISH_ADDRESS=0.0.0.0

# The time zone of the process, and of the quiet hours and the weekly reset
# estimate. UTC unless you set your own, for example America/New_York or
# Europe/London.
TZ=UTC
