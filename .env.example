# The daemon and its admin page, in a container.
#
#   docker compose up -d
#
# Copy this file to .env, fill in the tokens, and keep .env out of git.
# Never commit a real token: .env is ignored by git and by the build
# context (see .dockerignore).

# The image to run. Unset, you get the newest full release ("latest"), and
# "docker compose pull && docker compose up -d" upgrades. Set it to stay on one
# version, or to try a pre-release, which "latest" never points at, for example:
#   DASH_IMAGE=ghcr.io/jake1164/presto-ai-dash:0.50.0
#   DASH_IMAGE=ghcr.io/jake1164/presto-ai-dash:0.50.0-rc1
# DASH_IMAGE=

# REQUIRED. The admin page's token, at least 16 characters (the daemon refuses a
# shorter one, or a placeholder such as change-me). It is the password you log
# in to the admin page with, and it stays the same across restarts. Generate
# one and paste it after the "=":
#   openssl rand -hex 24
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
DASH_ADMIN_TOKEN=

# REQUIRED. The token the Presto device holds, at least 16 characters; generate
# a different one the same way. With none, the daemon would print a temporary
# token that stays in Docker's log.
DASH_SHARED_TOKEN=

# The host address the device port is published on. Leave it as it is to
# publish on every address, or set your LAN address (for example 192.168.1.50)
# so a host with a public interface does not expose it.
# DASH_PUBLISH_ADDRESS=0.0.0.0

# The names the admin page answers to, comma separated. Leave it unset to use
# the admin page from this machine only. To open it from another computer, list
# the name that computer will type, with the port, plus this machine's own names
# (for example: localhost:8788,127.0.0.1:8788,192.168.1.50:8788), and publish the
# port as described in the Docker guide.
# DASH_ADMIN_ALLOWED_HOSTS=localhost:8788,127.0.0.1:8788

# The encryption master key for the stored provider keys. Leave it unset: the
# daemon makes a key file in the data volume. Set it only to move the database
# to another machine (see "Data and backups" in the Docker guide).
# DASH_ENCRYPTION_KEY=

# How much the daemon logs: DEBUG, INFO, WARNING or ERROR. INFO by default.
# DASH_LOG_LEVEL=INFO

# How many local services (Ollama, LiteLLM) the Presto's Home screen lists in
# its overflow strip before they scroll. 1 by default.
# DASH_OVERFLOW_ROWS=1

# The time zone of the process, and of the quiet hours and the weekly reset
# estimate. UTC unless you set your own, for example America/New_York or
# Europe/London.
TZ=UTC

# Serve the Presto's screen in a browser at http://127.0.0.1:8790/, to try the
# container without a Presto. A test aid: the page has no sign-in, and Compose
# publishes it on this machine only. Leave it off otherwise.
# DASH_PRESTO_PREVIEW=1
# The names the preview page answers to, if you publish its port under another
# port or name. Only used with DASH_PRESTO_PREVIEW=1.
# DASH_PRESTO_PREVIEW_ALLOWED_HOSTS=localhost:8790,127.0.0.1:8790
