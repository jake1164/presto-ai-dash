# Build / test artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
# Documentation site and browser-check environments (mkdocs; Playwright).
.venv-*/

# Daemon runtime state
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.key
dash.toml
# A copy of a private file made by hand or by an editor
dash.toml.*
dash.toml~
*.bak
.local-backups/
# The container's tokens (see .env.example)
.env
.env.*
!.env.example

# Presto device files (never commit credentials)
presto/secrets.py
presto/config.py

# Editor / OS
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.DS_Store
Thumbs.db

# Presto preview renders and Playwright MCP output
.preview/
.playwright-mcp/

# The clickable demo's generated assets (tools/build_demo_site.py)
docs/user/demo/app/

# Agent scratch notes and reviews, never published
.ai_docs/
