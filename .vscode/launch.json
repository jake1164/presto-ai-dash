{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Daemon + configuration",
      "type": "debugpy",
      "request": "launch",
      "module": "presto_ai_dash.app",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "cwd": "${workspaceFolder}",
      "args": ["--config", "${workspaceFolder}/dash.toml", "--admin"],
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
