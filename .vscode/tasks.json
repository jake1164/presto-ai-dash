{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run all tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["-m", "unittest", "discover", "-s", "tests", "-q"],
      "options": { "cwd": "${workspaceFolder}/daemon" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Run test group",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["-m", "unittest", "discover", "-s", "tests/${input:testGroup}", "-t", "tests", "-q"],
      "options": { "cwd": "${workspaceFolder}/daemon" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Sync Presto",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["${workspaceFolder}/tools/presto_device.py", "sync", "--port", "${input:prestoPort}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Check Presto sync",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": { "command": "${workspaceFolder}/.venv/Scripts/python.exe" },
      "args": ["${workspaceFolder}/tools/presto_device.py", "check", "--port", "${input:prestoPort}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 }
    }
  ],
  "inputs": [
    {
      "id": "testGroup",
      "type": "pickString",
      "description": "Test group to run",
      "options": ["core", "admin", "providers", "ingest", "device", "security", "tooling"],
      "default": "core"
    },
    {
      "id": "prestoPort",
      "type": "promptString",
      "description": "Presto USB port (sync/check restarts AI Dash)",
      "default": "COM3"
    }
  ]
}
